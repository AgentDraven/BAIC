{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/falkoro/tokenmaxxing/blob/master/docs/model-candidates.v01.schema.json",
  "title": "BAIC v01 model candidates",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "providerId",
      "model",
      "plan",
      "tier",
      "monthlyCostUsd",
      "includedUnits",
      "remainingFraction",
      "taskSuccessRate",
      "averageUnitsPerTask"
    ],
    "properties": {
      "providerId": { "type": "string", "minLength": 1 },
      "model": { "type": "string", "minLength": 1 },
      "plan": { "type": "string", "minLength": 1 },
      "tier": { "enum": ["basic", "standard", "frontier"] },
      "monthlyCostUsd": { "type": "number", "minimum": 0 },
      "includedUnits": { "type": "number", "exclusiveMinimum": 0 },
      "remainingFraction": { "type": "number", "minimum": 0, "maximum": 1 },
      "taskSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
      "averageUnitsPerTask": { "type": "number", "exclusiveMinimum": 0 },
      "averageLatencyMs": { "type": "number", "minimum": 0 },
      "costPerAcceptedTaskUsd": { "type": "number", "minimum": 0 },
      "measurementConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "additionalProperties": false
  }
}
