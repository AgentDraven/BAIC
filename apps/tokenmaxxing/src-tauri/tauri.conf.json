{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokenmaxxing",
  "version": "0.7.14",
  "identifier": "com.falkoro.tokenmaxxing",
  "build": {
    "beforeDevCommand": "bun run bundle:plugins && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run bundle:plugins && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tokenmaxxing",
        "width": 400,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bundled_plugins/**/*",
      "icons/tray-icon.png",
      "icons/tray-icon-color.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "headerImage": "icons/nsis-header.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QTE2QkQyNjVEQkE5RTcKUldUbnFkdGwwbXVoV1BpMUcycHRoUSs1MTNkUi9uZTBXZlc2ZUV3enRVenFwLzdMTm01aFBYYTQK",
      "endpoints": [
        "https://github.com/falkoro/tokenmaxxing/releases/latest/download/latest.json"
      ]
    }
  }
}